# ---- Core -------------------------------------------------------------------
# Public origin, no trailing slash. Used for magic links and Stripe redirects.
BASE_URL=http://localhost:8080
PORT=8080
NODE_ENV=development

# Where the SQLite file lives. On Fly/Railway point this at a mounted volume.
DATABASE_PATH=./data/driftwatch.db

# Random 32+ byte secret: `openssl rand -hex 32`
SESSION_SECRET=

# ---- Email (magic links + alerts) -------------------------------------------
# Provider: "resend" | "postmark" | "none"
# "none" prints emails to stdout, which is fine for local development.
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=Driftwatch <alerts@yourdomain.com>

# Set to 1 to show magic-link URLs on screen instead of emailing them.
# NEVER enable this in production.
DRIFTWATCH_DEV_LOGIN=0

# ---- Stripe (this is the part that makes the money) -------------------------
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# From `stripe listen` or the dashboard webhook endpoint config.
STRIPE_WEBHOOK_SECRET=
# Recurring monthly prices you create in the Stripe dashboard.
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# ---- Scheduler --------------------------------------------------------------
# Believe X-Forwarded-For for client IPs. Correct behind a reverse proxy (Fly,
# Railway, Render, Caddy). Set to 0 if the process is directly exposed, where a
# client could otherwise spoof the header to reset its own rate limits.
TRUST_PROXY=1

SCHEDULER_ENABLED=1
SCHEDULER_TICK_MS=10000
SCHEDULER_CONCURRENCY=8
# Hard ceiling on any probed response body we will read, in bytes.
PROBE_MAX_BYTES=2000000
PROBE_TIMEOUT_MS=15000

# DANGEROUS on a multi-tenant deployment: allows monitors to target private and
# loopback addresses. Only turn this on for a single-tenant instance that is
# deliberately watching internal services.
PROBE_ALLOW_PRIVATE_TARGETS=0
